<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pocketworld</groupId>
    <artifactId>pocketworld-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>pocketworld-plugin</artifactId>
  <packaging>jar</packaging>

  <name>PocketWorld Plugin</name>
  <description>Paper plugin: PocketWorld runtime, world/theme domain model, UI, commands, and public API.</description>

  <properties>
    <!-- Pinned to a specific resolved build rather than a version range, for reproducible builds.
         Bump when a newer 26.2 build is needed: https://repo.papermc.io/repository/maven-public/ -->
    <paper-api.version>26.2.build.84-stable</paper-api.version>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.pocketworld</groupId>
      <artifactId>pocketworld-slime</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper-api.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>PocketWorld-${project.version}</finalName>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <relocations>
                <relocation>
                  <pattern>net.kyori.adventure.nbt</pattern>
                  <shadedPattern>com.pocketworld.libs.adventure.nbt</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.github.luben.zstd</pattern>
                  <shadedPattern>com.pocketworld.libs.zstd</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.zaxxer.hikari</pattern>
                  <shadedPattern>com.pocketworld.libs.hikari</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.mysql</pattern>
                  <shadedPattern>com.pocketworld.libs.mysql</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.mongodb</pattern>
                  <shadedPattern>com.pocketworld.libs.mongodb</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.bson</pattern>
                  <shadedPattern>com.pocketworld.libs.bson</shadedPattern>
                </relocation>
              </relocations>
              <!-- MySQL's driver auto-registers via META-INF/services/java.sql.Driver; this transformer
                   rewrites that file's contents to the relocated class name so ServiceLoader-based
                   discovery still works after shading. -->
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
